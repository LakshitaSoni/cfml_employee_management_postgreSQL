# Copy to .env (git-ignored, lives OUTSIDE the web root) and fill in real values.
# Real OS environment variables take precedence over values in this file.
# Never commit .env.

# --- Database (PostgreSQL) --------------------------------------------------
# If DB_HOST and DB_USER are set, the app defines its own datasource from
# these values. If they are empty, the app uses a datasource that you create
# in the ColdFusion Administrator (named DB_DATASOURCE below).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=admin_employee_management
DB_USER=emp_app
DB_PASSWORD=change-me
# Optional extra JDBC URL parameters, e.g. sslmode=require
# DB_PARAMS=
# Datasource name used by the app (default: admin_employee_management)
# DB_DATASOURCE=admin_employee_management

# --- Application --------------------------------------------------------------
# "development" enables ?reinit=1; anything else is treated as production.
APP_ENV=production
# INR, USD, EUR, GBP, JPY, AUD, CAD, AED (symbol used when displaying salaries)
APP_CURRENCY=INR
# Default rows per page in the directory (10, 25 or 50)
APP_PAGE_SIZE=10

# Table name inside DB_NAME (default: employees). Letters, digits, underscore only.
# DB_TABLE=employees
